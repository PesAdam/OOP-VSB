@startuml SmartMHD

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam ArrowColor #444444
skinparam ClassBorderColor #555555

' ─── Abstraktná trieda ───
abstract class Vehicle {
  # vehicleID : int
  # driver    : Driver
  # route     : Route
  --
  + Vehicle(id, d, r)
  + {abstract} drive() : void
  + setDriver(d : Driver) : void
  + setRoute(r : Route) : void
  + getID() : int
  + getDriver() : Driver
  + getRoute() : Route
  + {virtual} ~Vehicle()
}

' ─── Konkrétne triedy – potomkovia ───
class Bus {
  - fuelCapacity : double
  --
  + Bus(id, d, r, fuelCapacity)
  + drive() : void
  + refuel() : void
  + getFuelCapacity() : double
}

class Tram {
  - pantographVoltage : int
  --
  + Tram(id, d, r, voltage)
  + drive() : void
  + getPantographVoltage() : int
}

' ─── Triedy bez dedičnosti ───
class Driver {
  - name       : string
  - employeeID : int
  --
  + Driver()
  + Driver(name, employeeID)
  + getDetails() : string
  + getName() : string
  + getID() : int
}

class Route {
  - startStation : string
  - endStation   : string
  --
  + Route()
  + Route(start, end)
  + getRouteInfo() : string
  + getStart() : string
  + getEnd() : string
}

class TransportSystem {
  - fleet        : Vehicle*[]
  - fleetCount   : int
  - fleetCapacity: int
  --
  + TransportSystem(capacity)
  + ~TransportSystem()
  + addVehicle(v : Vehicle*) : void
  + assignRoute(v, r : Route) : void
  + assignRoute(v, start, dest : string) : void
  + startSimulation() : void
  + getVehicle(index) : Vehicle*
  + getFleetSize() : int
}

class Ticket {
  - {static} totalTicketsCount : int
  - price : double
  --
  + Ticket(price)
  + getPrice() : double
  + {static} getTicketsCount() : int
}

' ─── Vzťahy ───

' Dedičnosť (IS-A)
Vehicle <|-- Bus  : extends
Vehicle <|-- Tram : extends

' Kompozícia (HAS-A) – Vehicle vlastní Driver a Route
Vehicle *-- Driver : has
Vehicle *-- Route  : has

' Agregácia – TransportSystem spravuje kolekciu Vehicle*
TransportSystem o-- Vehicle : manages >

note bottom of Vehicle
  Abstraktná trieda – nedá sa
  priamo inštanciovať.
  drive() = 0 núti každého
  potomka implementovať metódu.
end note

note right of TransportSystem
  Polymorfná datová štruktúra:
  fleet[] uchováva Bus* aj Tram*
  cez spoločný typ Vehicle*.
  assignRoute() je pretažená metóda
  (overloading).
end note

note right of Ticket
  Trieda v roli objektu:
  totalTicketsCount je statický člen
  zdieľaný všetkými inštanciami.
  getTicketsCount() voláme ako
  Ticket::getTicketsCount().
end note

@enduml
